<mxfile host="app.diagrams.net"><diagram id="dfd" name="DFD corrigido"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Item 7 — DFD básico da API de atendimento ao cliente&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="0" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c2" value="➜ Preto = requisição (entrada)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#1F4FBF&quot;&gt;➜ Azul = resposta (saída)&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#D40000&quot;&gt;Vermelho = dado sensível&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;- - - Linha tracejada = trust boundary" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="160" y="34" width="1000" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;TRUST BOUNDARY 1&lt;/b&gt;&lt;br&gt;Internet → API" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="320" y="62" width="200" height="36" as="geometry"/></mxCell><mxCell id="c4" value="" style="line;strokeWidth=2.5;dashed=1;dashPattern=10 6;direction=south;html=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="415" y="100" width="10" height="690" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;TRUST BOUNDARY 2&lt;/b&gt;&lt;br&gt;API → Segredos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="865" y="62" width="200" height="36" as="geometry"/></mxCell><mxCell id="c6" value="" style="line;strokeWidth=2.5;dashed=1;dashPattern=10 6;direction=south;html=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="10" height="690" as="geometry"/></mxCell><mxCell id="cli" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;Usuário / Cliente&lt;/b&gt;&lt;br&gt;Browser, curl&lt;br&gt;ou Swagger UI" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="160" height="580" as="geometry"/></mxCell><mxCell id="main" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;fastapi / main.py&lt;/b&gt;&lt;br&gt;Roteamento&lt;br&gt;Validação Pydantic&lt;br&gt;(erro 422)&lt;br&gt;Handler de erro 401" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="170" height="620" as="geometry"/></mxCell><mxCell id="rA" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;GET /health&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rota pública&lt;/span&gt;&lt;br&gt;health_check()" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="210" height="120" as="geometry"/></mxCell><mxCell id="rB" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;POST /auth/token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;rota pública&lt;/span&gt;&lt;br&gt;login() + login_form()" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="210" height="120" as="geometry"/></mxCell><mxCell id="rC" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;POST /predict 🔒&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;exige Bearer JWT válido&lt;/span&gt;&lt;br&gt;predict()&lt;br&gt;intent simulada" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="680" y="610" width="210" height="120" as="geometry"/></mxCell><mxCell id="sec" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/div&gt;&lt;b style=&quot;font-size:16px&quot;&gt;security/auth.py&lt;/b&gt;&lt;br&gt;login_form()&lt;br&gt;gerar_token() — HS256, 30 min&lt;br&gt;validar_token_jwt()&lt;br&gt;confere sub == admin" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;verticalAlign=top;align=center;fontSize=12.5;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1040" y="340" width="250" height="180" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Segredos in-code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D40000&quot;&gt;SECRET_KEY [SENSÍVEL]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D40000&quot;&gt;admin / admin [SENSÍVEL]&lt;/font&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;top=1;bottom=1;fillColor=#FFFFFF;strokeWidth=2;strokeColor=#000000;spacingLeft=45;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="250" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=