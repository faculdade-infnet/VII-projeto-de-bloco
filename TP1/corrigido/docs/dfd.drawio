ell><mxCell id="c26" value="&lt;font color=&quot;#1F4FBF&quot;&gt;username ou 401&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=11.5;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="940" y="690" width="120" height="18" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;font-size:17px&quot;&gt;Fluxos por endpoint e trust boundaries atravessadas&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c28" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12.5px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;Endpoint&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;Entra na API (cruza TB1 →)&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;Acessa os segredos (cruza TB2)&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;Volta ao usuário (cruza TB1 ←)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;GET /health&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Nada (só a chamada)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Não&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;{&quot;status&quot;: &quot;ok&quot;}&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;POST /auth/token&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;username + &lt;font color=&quot;#D40000&quot;&gt;password [SENSÍVEL]&lt;/font&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Sim: lê admin/admin e SECRET_KEY para gerar o token&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;font color=&quot;#D40000&quot;&gt;access_token [SENSÍVEL]&lt;/font&gt; ou 401&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;POST /predict&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;font color=&quot;#D40000&quot;&gt;Bearer JWT [SENSÍVEL]&lt;/font&gt; + text&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Sim: lê SECRET_KEY para validar o token e confere se o sub é admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;intent ou 401&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1300" height="150" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;font-size:17px&quot;&gt;Tríade CIA por componente&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1300" height="26" as="geometry"/></mxCell><mxCell id="c30" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12.5px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;#&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;Componente&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;CONFIDENCIALIDADE&lt;br&gt;o que não pode vazar&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;INTEGRIDADE&lt;br&gt;o que não pode ser alterado&lt;/th&gt;&lt;th style=&quot;border:1px solid #000;padding:6px;background:#EEEEEE;text-align:left&quot;&gt;DISPONIBILIDADE&lt;br&gt;o que precisa estar no ar&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;Usuário / Cliente&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;As &lt;font color=&quot;#D40000&quot;&gt;credenciais&lt;/font&gt; e o &lt;font color=&quot;#D40000&quot;&gt;token&lt;/font&gt; ficam sob sua guarda.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Sua identidade: ninguém mais pode agir como admin.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Não se aplica: é entidade externa, fora do controle da API.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;—&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;Dados enviados (entradas)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;font color=&quot;#D40000&quot;&gt;password&lt;/font&gt; e &lt;font color=&quot;#D40000&quot;&gt;Bearer &amp;lt;JWT&amp;gt;&lt;/font&gt;. Hoje trafegam em HTTP sem TLS.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O campo &lt;b&gt;text&lt;/b&gt; deve chegar ao processamento sem modificação.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O canal HTTP precisa aceitar a requisição.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;fastapi / main.py&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;i&gt;Tracebacks&lt;/i&gt; e a página &lt;b&gt;/docs&lt;/b&gt; revelam a estrutura interna da API.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O código em execução precisa ser o código auditado.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Processo único, sem réplica: se cai, toda a API cai.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;GET /health&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Não expõe dado sensível, só o status.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O status precisa refletir o estado real da API.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;É o próprio indicador de disponibilidade; sem ele o monitoramento fica cego.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;POST /auth/token&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O &lt;font color=&quot;#D40000&quot;&gt;access_token&lt;/font&gt; devolvido. O erro não pode revelar se o usuário existe.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;A regra de comparação de senha: se adulterada, emite token sem credencial válida.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Sem ela ninguém consegue token, e o /predict fica inacessível.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;POST /predict&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;A resposta só pode ser entregue a quem apresentou token válido do admin.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O &lt;b&gt;intent&lt;/b&gt; deve corresponder ao &lt;b&gt;text&lt;/b&gt; recebido. A partir do TP2, decisão do modelo.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;É a rota de negócio: indisponível equivale à queda do produto.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;6 / D1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;security/auth.py + segredos&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;font color=&quot;#D40000&quot;&gt;SECRET_KEY&lt;/font&gt; e &lt;font color=&quot;#D40000&quot;&gt;admin/admin&lt;/font&gt;. Com a chave, um atacante &lt;b&gt;forja tokens&lt;/b&gt; sem saber a senha.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;A chave e o usuário válido. Trocá-los por valores conhecidos abre a API inteira.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;Necessária para &lt;b&gt;emitir e validar&lt;/b&gt; tokens: sem ela ninguém entra.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;—&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;&lt;b&gt;Saídas (respostas)&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;O &lt;font color=&quot;#D40000&quot;&gt;access_token&lt;/font&gt; e o &lt;b&gt;intent&lt;/b&gt; não podem chegar a terceiros.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;A resposta não pode ser adulterada no caminho de volta.&lt;/td&gt;&lt;td style=&quot;border:1px solid #000;padding:6px;vertical-align:top;text-align:left&quot;&gt;A resposta precisa efetivamente chegar ao solicitante.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1300" height="430" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>